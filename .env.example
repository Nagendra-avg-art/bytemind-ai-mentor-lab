# ==============================================================================
# AI Provider Configuration
# Supported:
# - 'ollama' (default for local development)
# - 'groq'   (for public cloud deployment on Render)
# - 'gemini' (optional cloud provider / fallback)
# ==============================================================================
AI_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 1. Local AI (Ollama) - Default for local development
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ------------------------------------------------------------------------------
# 2. Public Cloud AI (Groq) - Used on Render (AI_PROVIDER=groq)
# Fast, low-latency cloud inference without local GPU requirements.
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ------------------------------------------------------------------------------
# 3. Cloud AI (Google Gemini) - Optional provider / fallback (AI_PROVIDER=gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
PORT=3001

# ==============================================================================
# Step 5.6: Persistent Vector Storage Configuration (Optional)
# Target: PostgreSQL with pgvector (supports Supabase PostgreSQL)
#
# If left blank or unset, ByteMind automatically falls back to in-memory
# vector storage, allowing full local development without a database.
# ==============================================================================
# Option 1: Connection URI (e.g. Supabase Connection String or local Postgres)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option 2: Individual Connection Parameters
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=bytemind
# PGUSER=postgres
# PGPASSWORD=your_database_password

# ==============================================================================
# Step 5.7: RAG Retrieval Quality & Similarity Threshold
# Minimum cosine similarity score (0.0 to 1.0) required to consider a chunk relevant.
# Chunks below this threshold are rejected to prevent hallucinating on unrelated queries.
# Default: 0.45
# ==============================================================================
RAG_SIMILARITY_THRESHOLD=0.45
 
# ==============================================================================
# Step 15: Local AI Feasibility Lab (Optional Local Intent Classification)
# Set to 'true' to enable local ONNX intent classification experiment.
# Set to 'false' (or omit) to use existing deterministic rule-based routing.
# ==============================================================================
LOCAL_AI_EXPERIMENT=true

